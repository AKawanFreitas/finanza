# Copie para .env e ajuste. Todos são opcionais.
PORT=4747
# Endereço público do app (usado nos links dos e-mails)
APP_URL=http://localhost:4747
# Sem SMTP_URL, os e-mails aparecem nos logs do contêiner
# SMTP_URL=smtps://usuario:senha@smtp.exemplo.com
EMAIL_FROM=Finanza <nao-responda@finanza.local>
# Quantos backups diários manter
BACKUP_KEEP=7
LOG_LEVEL=info
# false enquanto usar http://localhost; remova quando houver HTTPS
COOKIE_SECURE=false
# TRUST_PROXY=1
