# Copie para .env (cp .env.example .env). Todos são opcionais.
# O .env é lido pela API (backend/.env ou este, da raiz) e pelo docker compose, e NÃO vai para o git.
PORT=4747
# Endereço público do app, usado nos links dos e-mails. Padrão: http://localhost:5173 (dev) e
# http://localhost:4747 (Docker). Só defina se for diferente.
# APP_URL=https://app.exemplo.com.br
# Sem SMTP_URL, os e-mails aparecem no terminal da API (ou nos logs do contêiner), com os links
# SMTP_URL=smtps://usuario:senha@smtp.exemplo.com
EMAIL_FROM=Finanza <nao-responda@finanza.local>
# Quantos backups diários manter
BACKUP_KEEP=7
LOG_LEVEL=info
# false enquanto usar http://localhost; remova quando houver HTTPS
COOKIE_SECURE=false
# TRUST_PROXY=1

# ── Contas de teste ─────────────────────────────────────────────────────────────
# Descomente e escolha as senhas: a API cria estas contas ao subir, se o e-mail ainda não existir
# (nunca altera uma conta existente). Use só em teste local; as senhas ficam no SEU .env, que não vai para o git.
# BOOTSTRAP_ADMIN_EMAIL=admin@finanza.local
# BOOTSTRAP_ADMIN_SENHA=escolha-uma-senha-com-8-ou-mais-caracteres
# BOOTSTRAP_ADMIN_NOME=Admin
# Usuário comum com 5 meses de lançamentos de exemplo, para ver o app preenchido
# BOOTSTRAP_DEMO=true
# BOOTSTRAP_DEMO_EMAIL=demo@finanza.local
# BOOTSTRAP_DEMO_SENHA=escolha-uma-senha
